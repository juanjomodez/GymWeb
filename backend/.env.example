# Copiar a backend/.env. Introducir la URI real SOLO en ese archivo local.
# Sustituir los marcadores con datos de Atlas; codificar caracteres especiales
# del usuario y contraseña con percent-encoding. No compartir ni subir la URI.
MONGODB_URI=
# La aplicación usa esta base explícitamente, incluso si la URI contiene otra.
MONGODB_DB=GymWeb
# Opcional si el DNS de la red bloquea Atlas. Vacío usa el DNS del sistema.
# Ejemplo: MONGODB_DNS_SERVERS=1.1.1.1,1.0.0.1
MONGODB_DNS_SERVERS=
HOST=127.0.0.1
PORT=3000
# Opcionales: la simulación requiere ambos valores y está apagada por defecto.
# npm run start:demo la activa solo en el proceso de desarrollo.
NODE_ENV=development
ENABLE_DEMO_PAYMENTS=false
